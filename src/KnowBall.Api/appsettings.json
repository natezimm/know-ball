{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Trivia": "Host=localhost;Port=5432;Database=sports_trivia;Username=trivia;Password=trivia"
  },
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Games": {
    "GuessesPerMinute": 60,
    "Leagues": "nba,nfl"
  },
  "Telemetry": {
    "TraceSampleRatio": 0.25
  }
}
