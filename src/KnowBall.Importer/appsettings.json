{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "Trivia": "Host=localhost;Port=5432;Database=sports_trivia;Username=trivia;Password=trivia"
  },
  "Database": {
    "Provider": "Postgres"
  },
  "Import": {
    "Leagues": "nba,nfl",
    "Source": "espn",
    "FallbackSource": "",
    "DailyAt": "04:00",
    "TimeZone": "America/New_York",
    "RunOnStartup": true,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 60,
    "HistoryRefreshDays": 30,
    "PuzzleDaysAhead": 30,
    "PracticeRetentionDays": 7
  },
  "Games": {
    "Leagues": "nba,nfl"
  },
  "Sources": {
    "Espn": {
      "BaseUrl": "https://site.api.espn.com/apis/site/v2/sports/basketball/nba/",
      "FallbackBaseUrl": "https://site.web.api.espn.com/apis/site/v2/sports/basketball/nba/",
      "TimeoutSeconds": 30
    },
    "Bref": {
      "BaseUrl": "https://raw.githubusercontent.com/sumitrodatta/bball-reference-datasets/master/Data/",
      "Directory": "",
      "TimeoutSeconds": 120
    },
    "Nflverse": {
      "BaseUrl": "https://github.com/nflverse/nflverse-data/releases/download/",
      "Directory": "",
      "TimeoutSeconds": 180,
      "FirstSeason": 1990,
      "WeeklyFromSeason": 2016
    },
    "Wikidata": {
      "Endpoint": "https://query.wikidata.org/sparql",
      "TimeoutSeconds": 90
    },
    "NbaStats": {
      "BaseUrl": "https://stats.nba.com/stats/",
      "Season": "",
      "TimeoutSeconds": 60
    },
    "Seed": {
      "Path": "Data/nba-sample-players.json"
    }
  },
  "Telemetry": {
    "TraceSampleRatio": 1.0
  }
}
